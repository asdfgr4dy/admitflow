ADMITFLOW_DB_HOST=127.0.0.1
ADMITFLOW_DB_PORT=3306
ADMITFLOW_DB_DATABASE=admitflow
ADMITFLOW_DB_USERNAME=your_database_user
ADMITFLOW_DB_PASSWORD=replace_with_a_local_secret
ADMITFLOW_DB_CHARSET=utf8mb4
ADMITFLOW_APP_URL=http://127.0.0.1:8000
ADMITFLOW_APP_ENV=local
ADMITFLOW_FORCE_SECURE_COOKIES=0
# Set to 1 only when a trusted reverse proxy overwrites X-Forwarded-Proto.
ADMITFLOW_TRUST_PROXY=0
ADMITFLOW_MAIL_ENABLED=0
ADMITFLOW_MAIL_LOCAL_FALLBACK=0
ADMITFLOW_MAIL_HOST=smtp.gmail.com
ADMITFLOW_MAIL_PORT=587
ADMITFLOW_MAIL_USERNAME=your-gmail-address@gmail.com
ADMITFLOW_MAIL_PASSWORD=your-google-app-password
ADMITFLOW_MAIL_ENCRYPTION=tls
ADMITFLOW_MAIL_FROM_ADDRESS=your-gmail-address@gmail.com
ADMITFLOW_MAIL_FROM_NAME=AdmitFlow Admissions